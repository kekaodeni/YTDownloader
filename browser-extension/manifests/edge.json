{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "1.0.0",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_send__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
